{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "porchi-website",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "porchi-website","database_id": "0b74ebeb-8f92-4ffb-b486-8e35f061317c",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "porchi-website","preview_bucket_name": "porchi-website",
		},
	],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "3eda6d9d990b41d78804c6396c8b7c1a"
    }
  ],	// Worker Loader for plugin sandboxing
	//"worker_loaders": [
	//	{
	//		"binding": "LOADER",
	//	},
	//],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}

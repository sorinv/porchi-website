{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "porchi-website",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "porchi-website",
			"database_id": "0f0dd208-c960-42bc-87e8-d0e9e0c5fac7",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "porchi-website","preview_bucket_name": "porchi-website",
		},
	],
  	// Worker Loader for plugin sandboxing
	//"worker_loaders": [
	//	{
	//		"binding": "LOADER",
	//	},
	//],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "3ac1f3cc604a47fca1f069d216f11288"
    }
  ],	
// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
